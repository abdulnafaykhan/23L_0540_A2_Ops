# VisionGuard Environment Variables Template (.env.example)
# Copy this to .env and fill in your confidential credentials

# Flask Configuration
PORT=5000
FLASK_DEBUG=False
SECRET_KEY=your_secure_random_flask_secret_key_here
MAX_FILE_SIZE_MB=5

# Model Inference Configuration
MODEL_PATH=champion_mobilenetv2_best.keras
MODEL_NAME=champion_mobilenetv2
THRESHOLD=0.5

# Database Configuration (PostgreSQL / SQLite)
DATABASE_PATH=visionguard.db
DB_USER=visionuser
DB_PASSWORD=your_strong_password_here
DB_NAME=visionguard_db
DB_HOST=db
DB_PORT=5432

# DagsHub & MLflow Tracking Credentials
DAGSHUB_REPO_OWNER=ankhanburki
DAGSHUB_REPO_NAME=23L_0540_A2_Ops
MLFLOW_TRACKING_URI=https://dagshub.com/ankhanburki/23L_0540_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=ankhanburki
DAGSHUB_USER_TOKEN=your_dagshub_token_here
